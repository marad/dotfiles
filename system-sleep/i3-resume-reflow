#!/bin/bash
# systemd system-sleep hook: rebuild the i3 layout after resume.
#
# Installed to /usr/lib/systemd/system-sleep/i3-resume-reflow by install.sh.
# systemd runs this as root around suspend/resume with:
#   $1 = pre|post   $2 = suspend|hibernate|...
#
# On "post" (resume) we locate the running i3, recover the user's X
# environment straight from the i3 process, and run i3-reflow-all as that user
# after the displays have had a moment to settle. This repairs the gap/layout
# churn that an output flap during resume leaves behind.
#
# Detached with setsid + "&" so it never blocks the resume transition.

[ "$1" = "post" ] || exit 0

for pid in $(pgrep -x i3 2>/dev/null); do
    user="$(ps -o user= -p "$pid" 2>/dev/null | tr -d ' ')"
    [ -n "$user" ] || continue

    environ="/proc/$pid/environ"
    [ -r "$environ" ] || continue
    display="$(tr '\0' '\n' < "$environ" | sed -n 's/^DISPLAY=//p'    | head -n1)"
    xauth="$(tr '\0' '\n'   < "$environ" | sed -n 's/^XAUTHORITY=//p' | head -n1)"
    [ -n "$display" ] || continue

    home="$(getent passwd "$user" | cut -d: -f6)"
    [ -n "$xauth" ] || xauth="$home/.Xauthority"

    setsid su "$user" -c \
        "DISPLAY='$display' XAUTHORITY='$xauth' PATH='$home/bin:$home/.local/bin:/usr/bin:/bin' sh -c 'sleep 5; i3-reflow-all'" \
        >/dev/null 2>&1 &
done

exit 0

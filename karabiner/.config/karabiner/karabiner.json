                                "from": {
                                    "pointing_button": "button5",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "set_variable": { "name": "swipe_scroll", "value": 1 } }],
                                "to_after_key_up": [{ "set_variable": { "name": "swipe_scroll", "value": 0 } }],
                                "to_if_alone": [{ "pointing_button": "button5" }],
                                "parameters": { "basic.to_if_alone_timeout_milliseconds": 250 }

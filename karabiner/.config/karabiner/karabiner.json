                                "from": { "modifiers": { "optional": ["any"] } },
                                "options": {
                                    "momentum_scroll_enabled": true,
                                    "speed_multiplier": 0.6,
                                    "recent_time_duration_milliseconds": 40,
                                    "direction_lock_threshold": 20

#!/usr/bin/env bash
#
# i3blocks block: Claude Code rate-limit usage, as graphical progress bars.
#
# Shows utilization of the two unified rate-limit windows that `/usage`
# reports in Claude Code:
#   - 5h  : the rolling 5-hour "session" window
#   - 7d  : the rolling weekly window
#
# Each window is drawn as a solid bar: the coloured fill is how much of the
# limit is used, and a vertical marker line shows how far the time window
# itself has elapsed (start -> reset). Fill behind the marker = burning the
# budget slower than the clock; fill ahead of the marker = burning faster.
#
# The numbers are not stored locally; they live in the response headers of
# the Anthropic API. We read the OAuth access token that Claude Code keeps
# in ~/.claude/.credentials.json and issue one minimal request (1 output
# token) to read the `anthropic-ratelimit-unified-*` headers. Results are
# cached for $CLAUDE_USAGE_TTL seconds so the bar does not hammer the API.
#
# Requires `markup=pango` on this i3blocks block (for the coloured bars).
#
# Configuration (environment variables):
#   CLAUDE_USAGE_TTL        seconds between live refreshes   (default 120)
#   CLAUDE_USAGE_LABEL      text prefix shown in the bar      (default "CC")
#   CLAUDE_USAGE_BAR_WIDTH  bar width in cells                (default 8)
#   CLAUDE_CREDENTIALS      path to the credentials file      (default ~/.claude/.credentials.json)
#   CLAUDE_USAGE_WARN       utilization fraction for yellow   (default 0.7)
#   CLAUDE_USAGE_CRIT       utilization fraction for red       (default 0.9)
#
# Output follows the i3blocks protocol: full_text, short_text, color.

set -uo pipefail

CRED="${CLAUDE_CREDENTIALS:-$HOME/.claude/.credentials.json}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/i3-claude-status"
CACHE="$CACHE_DIR/usage.env"
TTL="${CLAUDE_USAGE_TTL:-120}"
LABEL="${CLAUDE_USAGE_LABEL:-CC}"
WARN="${CLAUDE_USAGE_WARN:-0.7}"
CRIT="${CLAUDE_USAGE_CRIT:-0.9}"
BAR_WIDTH="${CLAUDE_USAGE_BAR_WIDTH:-8}"

# Window lengths in seconds (used to place the elapsed-time marker).
WIN_5H="${CLAUDE_USAGE_WIN_5H:-18000}"     # 5 hours
WIN_7D="${CLAUDE_USAGE_WIN_7D:-604800}"    # 7 days

# Colours.
FILL_OK="${CLAUDE_USAGE_FILL_OK:-#98C379}"     # green   (low usage)
FILL_WARN="${CLAUDE_USAGE_FILL_WARN:-#E5C07B}" # yellow  (>= WARN)
FILL_CRIT="${CLAUDE_USAGE_FILL_CRIT:-#E06C75}" # red     (>= CRIT / rejected)
TRACK="${CLAUDE_USAGE_TRACK:-#3A3F4B}"         # empty part of the bar
MARKER="${CLAUDE_USAGE_MARKER:-#61AFEF}"       # elapsed-time marker line
TEXT="${CLAUDE_USAGE_TEXT:-#ABB2BF}"           # labels / default text
STALE="${CLAUDE_USAGE_STALE:-#606060}"         # dimmed when data is stale

mkdir -p "$CACHE_DIR"
now=$(date +%s)

# Cached values (empty until first successful fetch).
FETCHED=0; U5=""; R5=""; U7=""; R7=""; ST=""
if [[ -f "$CACHE" ]]; then
  # shellcheck disable=SC1090
  source "$CACHE"
fi

fetch_usage() {
  local token headers
  token=$(jq -r '.claudeAiOauth.accessToken // empty' "$CRED" 2>/dev/null) || return 1
  [[ -n "$token" ]] || return 1

  headers=$(curl -sS --max-time 8 -D - -o /dev/null \
    https://api.anthropic.com/v1/messages \
    -H "Authorization: Bearer $token" \
    -H "anthropic-version: 2023-06-01" \
    -H "anthropic-beta: oauth-2025-04-20,claude-code-20250219" \
    -H "content-type: application/json" \
    -d '{"model":"claude-haiku-4-5-20251001","max_tokens":1,"system":"You are Claude Code, Anthropic'\''s official CLI for Claude.","messages":[{"role":"user","content":"."}]}' \
    2>/dev/null) || return 1

  local h
  h() { grep -i "^anthropic-ratelimit-unified-$1:" <<<"$headers" | tail -1 | tr -d '\r' | awk '{print $2}'; }
  local n5 nr5 n7 nr7 nst
  n5=$(h 5h-utilization); nr5=$(h 5h-reset)
  n7=$(h 7d-utilization); nr7=$(h 7d-reset)
  nst=$(h status)

  # Require at least one utilization value, otherwise treat as failure.
  [[ -n "$n5$n7" ]] || return 1

  U5="$n5"; R5="$nr5"; U7="$n7"; R7="$nr7"; ST="$nst"; FETCHED="$now"
  cat >"$CACHE" <<EOF
FETCHED=$FETCHED
U5=$U5
R5=$R5
U7=$U7
R7=$R7
ST=$ST
EOF
  return 0
}

# Refresh only if the cache is older than the TTL.
stale=0
if (( now - FETCHED >= TTL )); then
  if ! fetch_usage; then
    # Fetch failed: keep showing cached data (dimmed) if we have any.
    [[ -n "$U5$U7" ]] && stale=1
  fi
fi

# --- formatting helpers ---------------------------------------------------

pct() { # fraction -> integer percent
  awk -v v="${1:-0}" 'BEGIN{ if (v=="") v=0; printf "%d", v*100 + 0.5 }'
}

fill_color() { # utilization fraction -> colour (rejected status forces red)
  local u="${1:-0}"; [[ -z "$u" ]] && u=0
  if [[ "$ST" == "rejected" ]] || awk -v w="$u" -v c="$CRIT" 'BEGIN{exit !(w>=c)}'; then
    printf '%s' "$FILL_CRIT"
  elif awk -v w="$u" -v c="$WARN" 'BEGIN{exit !(w>=c)}'; then
    printf '%s' "$FILL_WARN"
  else
    printf '%s' "$FILL_OK"
  fi
}

elapsed_frac() { # reset_epoch, window_length -> fraction of window already gone
  awk -v r="${1:-}" -v len="${2:-1}" -v now="$now" 'BEGIN{
    if (r=="") { print 0; exit }
    rem = r - now; if (rem < 0) rem = 0; if (rem > len) rem = len;
    print (len - rem) / len;
  }'
}

# Build a pango progress bar with a vertical elapsed-time marker.
#   $1 utilization fraction, $2 elapsed fraction, $3 fill colour
make_bar() {
  local util="${1:-0}" elapsed="${2:-0}" fill="$3"
  [[ -z "$util" ]] && util=0
  awk -v u="$util" -v e="$elapsed" -v w="$BAR_WIDTH" \
      -v fc="$fill" -v ec="$TRACK" -v mc="$MARKER" 'BEGIN{
    if (u=="") u=0; if (e=="") e=0;
    f = int(u*w + 0.5); if (f>w) f=w; if (f<0) f=0;
    mk = int(e*w);       if (mk>=w) mk=w-1; if (mk<0) mk=0;
    for (i=0; i<w; i++) {
      bg = (i<f) ? fc : ec;
      if (i==mk)
        printf "<span background=\"%s\" foreground=\"%s\">▏</span>", bg, mc;
      else
        printf "<span background=\"%s\"> </span>", bg;
    }
  }'
}

# --- no data at all -------------------------------------------------------

if [[ -z "$U5$U7" ]]; then
  echo "$LABEL n/d"
  echo "$LABEL"
  echo "$STALE"
  exit 0
fi

# --- render ---------------------------------------------------------------

p5=$(pct "$U5"); p7=$(pct "$U7")
fc5=$(fill_color "$U5"); fc7=$(fill_color "$U7")
e5=$(elapsed_frac "$R5" "$WIN_5H"); e7=$(elapsed_frac "$R7" "$WIN_7D")
bar5=$(make_bar "$U5" "$e5" "$fc5"); bar7=$(make_bar "$U7" "$e7" "$fc7")
mark=""; (( stale )) && mark="·"   # trailing dot marks cached/stale data

full=$(printf '%s%s 5h %s <span foreground="%s">%d%%</span>  7d %s <span foreground="%s">%d%%</span>' \
  "$LABEL" "$mark" "$bar5" "$fc5" "$p5" "$bar7" "$fc7" "$p7")
short="$LABEL ${p5}%/${p7}%"

echo "$full"
echo "$short"
(( stale )) && echo "$STALE" || echo "$TEXT"
